<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- Sem a thread extra de coleta de lixo: menos memoria com o programa parado -->
    <gcConcurrent enabled="false"/>
    <!-- Nao consulta certificado na abertura: abre mais rapido -->
    <generatePublisherEvidence enabled="false"/>
  </runtime>
</configuration>
